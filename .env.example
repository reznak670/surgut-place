# Скопируйте в .env и заполните. .env не коммитить!

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:REPLACE_ME
# tg_id админов через запятую (узнать у @userinfobot)
ADMIN_IDS=111111111
# Чат для алертов: фидбэк ≤3, «Предложить место», брони без партнёра, просроченные заявки
ADMIN_CHAT_ID=111111111

# БД: SQLite — только для разработки. В ПРОДЕ НУЖЕН POSTGRES
# (SQLite держит одну блокировку записи на весь файл → «database is locked» под нагрузкой).
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://surgut:change-me@127.0.0.1:5432/surgut_place

# Redis для FSM-состояний (пусто → MemoryStorage, состояния теряются при рестарте)
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379/0

# Хранение фото: telegram (file_id / URL)
PHOTO_STORAGE=telegram
# S3 — опционально, пока не используется
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

TZ=Asia/Yekaterinburg
PRIVACY_POLICY_URL=https://example.com/privacy
LOG_LEVEL=INFO

# Режим «мороз» (1/true/yes — включён)
FROST_MODE=false
# Папка со статикой бота (пусто → <корень проекта>/assets)
ASSETS_DIR=
