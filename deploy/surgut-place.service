# Системный сервис (system unit) для VPS.
# Установка: sudo cp deploy/surgut-place.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now surgut-place
# Ожидается: пользователь `surgut`, проект в /opt/surgut-place, `uv sync --frozen --no-dev` выполнен,
# .env лежит в /opt/surgut-place/.env (chmod 600, владелец surgut).
[Unit]
Description=Surgut Place Telegram bot
Wants=network-online.target
After=network-online.target postgresql.service redis.service

[Service]
Type=simple
User=surgut
Group=surgut
WorkingDirectory=/opt/surgut-place
EnvironmentFile=/opt/surgut-place/.env
Environment=PYTHONUNBUFFERED=1
# миграции перед стартом — безопасно, alembic идемпотентен
ExecStartPre=/opt/surgut-place/.venv/bin/alembic upgrade head
ExecStart=/opt/surgut-place/.venv/bin/python -m app
Restart=always
RestartSec=5
TimeoutStopSec=20

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/surgut-place
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
